generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model abbonamenti {
  id_abbonamento Int              @id @default(autoincrement())
  piano          String
  costo_mensile  Float
  sottoscrizioni sottoscrizioni[]
}

model artisti {
  id_artista Int         @id @default(autoincrement())
  nome       String
  partecipa  partecipa[]
}

model assets_audio {
  id_asset_audio Int       @id @default(autoincrement())
  codec          String?
  url_traccia    String
  id_lingua      Int       @default(2)
  lingue         lingue    @relation(fields: [id_lingua], references: [id_lingua], onDelete: NoAction, onUpdate: NoAction)
  include        include[]
}

model assets_video {
  id_asset_video Int          @id @default(autoincrement())
  bitrate        Int?
  codec          String?
  url_manifest   String
  codificato     codificato[]
}

model classificato_in {
  id_genere    Int
  id_contenuto Int
  contenuti    contenuti @relation(fields: [id_contenuto], references: [id_contenuto], onDelete: NoAction, onUpdate: NoAction)
  generi       generi    @relation(fields: [id_genere], references: [id_genere], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_genere, id_contenuto])
}

model codificato {
  id_asset_video Int
  id_contenuto   Int
  contenuti      contenuti    @relation(fields: [id_contenuto], references: [id_contenuto], onDelete: NoAction, onUpdate: NoAction)
  assets_video   assets_video @relation(fields: [id_asset_video], references: [id_asset_video], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_asset_video, id_contenuto])
}

model contenuti {
  id_contenuto     Int               @id @default(autoincrement())
  descrizione      String?
  anno_rilascio    Int?
  durata           Int?
  titolo_contenuto String
  tipo             String
  id_stagione      Int?
  copertina_url    String?       
  vposter_url      String?
  classificato_in  classificato_in[]
  codificato       codificato[]
  stagioni         stagioni?         @relation(fields: [id_stagione], references: [id_stagione], onDelete: NoAction, onUpdate: NoAction)
  guarda           guarda[]
  include          include[]
  liste            liste[]
  partecipa        partecipa[]
  salva_film       salva_film[]
  soggetto_a       soggetto_a[]
  sottotitoli      sottotitoli[]
  valutazioni      valutazioni[]
}

model fatture {
  id_fattura     Int              @id @default(autoincrement())
  importo        Float
  FILE           String
  data_emissione DateTime
  created_at     DateTime?        @default(now())
  updated_at     DateTime?        @default(now())
  sottoscrizioni sottoscrizioni[]
}

model generi {
  id_genere       Int               @id @default(autoincrement())
  nome_genere     String
  classificato_in classificato_in[]
}

model guarda {
  durata_visualizzata Int?
  stato_completamento Int?
  id_contenuto        Int
  id_profilo          Int
  profili             profili   @relation(fields: [id_profilo], references: [id_profilo], onDelete: NoAction, onUpdate: NoAction)
  contenuti           contenuti @relation(fields: [id_contenuto], references: [id_contenuto], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_contenuto, id_profilo])
}

model include {
  id_asset_audio Int
  id_contenuto   Int
  contenuti      contenuti    @relation(fields: [id_contenuto], references: [id_contenuto], onDelete: NoAction, onUpdate: NoAction)
  assets_audio   assets_audio @relation(fields: [id_asset_audio], references: [id_asset_audio], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_asset_audio, id_contenuto])
}

model licenze {
  id_licenza    Int          @id @default(autoincrement())
  tipo_licenza  String?
  data_scadenza DateTime?
  territorio    String?
  soggetto_a    soggetto_a[]
}

model lingue {
  id_lingua   Int           @id @default(autoincrement())
  nome        String
}

model liste {
  id_profilo   Int
  id_contenuto Int
  contenuti    contenuti @relation(fields: [id_contenuto], references: [id_contenuto], onDelete: NoAction, onUpdate: NoAction)
  profili      profili   @relation(fields: [id_profilo], references: [id_profilo], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_profilo, id_contenuto])
}

model partecipa {
  id_artista   Int
  id_contenuto Int
  contenuti    contenuti @relation(fields: [id_contenuto], references: [id_contenuto], onDelete: NoAction, onUpdate: NoAction)
  artisti      artisti   @relation(fields: [id_artista], references: [id_artista], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_artista, id_contenuto])
}

model profili {
  id_profilo   Int           @id @default(autoincrement())
  pin_profilo  String?
  lingua       String?
  nome_profilo String
  avatar_url   String?
  id_utente    Int
  guarda       guarda[]
  liste        liste[]
  utenti       utenti        @relation(fields: [id_utente], references: [id_utente], onDelete: NoAction, onUpdate: NoAction)
  salva_film   salva_film[]
  salva_serie  salva_serie[]
  valutazioni  valutazioni[]
}

model salva_film {
  id_film    Int
  id_profilo Int
  profili    profili   @relation(fields: [id_profilo], references: [id_profilo], onDelete: NoAction, onUpdate: NoAction)
  contenuti  contenuti @relation(fields: [id_film], references: [id_contenuto], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_film, id_profilo])
}

model salva_serie {
  id_serie_tv Int
  id_profilo  Int
  profili     profili  @relation(fields: [id_profilo], references: [id_profilo], onDelete: NoAction, onUpdate: NoAction)
  serie_tv    serie_tv @relation(fields: [id_serie_tv], references: [id_serie_tv], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_serie_tv, id_profilo])
}

model serie_tv {
  id_serie_tv     Int           @id @default(autoincrement())
  titolo_serie_tv String
  descrizione     String?
  anno_inizio     Int?
  img_hero        String?
  vposter_url     String?
  salva_serie     salva_serie[]
  stagioni        stagioni[]
  valutazioni     valutazioni[]
}

model soggetto_a {
  id_licenza   Int
  id_contenuto Int
  contenuti    contenuti @relation(fields: [id_contenuto], references: [id_contenuto], onDelete: NoAction, onUpdate: NoAction)
  licenze      licenze   @relation(fields: [id_licenza], references: [id_licenza], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_licenza, id_contenuto])
}

model sottoscrizioni {
  id_sottoscrizione          Int         @id @default(autoincrement())
  data_inizio_sottoscrizione DateTime
  data_scadenza              DateTime
  id_utente                  Int
  id_abbonamento             Int
  id_fattura                 Int
  fatture                    fatture     @relation(fields: [id_fattura], references: [id_fattura], onDelete: NoAction, onUpdate: NoAction)
  abbonamenti                abbonamenti @relation(fields: [id_abbonamento], references: [id_abbonamento], onDelete: NoAction, onUpdate: NoAction)
  utenti                     utenti      @relation(fields: [id_utente], references: [id_utente], onDelete: NoAction, onUpdate: NoAction)
}

model sottotitoli {
  id_sub       Int       @id @default(autoincrement())
  url_sub      String
  formato      String?
  tipo_traccia String?
  id_contenuto Int
  id_lingua    Int       @default(2)
  contenuti    contenuti @relation(fields: [id_contenuto], references: [id_contenuto], onDelete: NoAction, onUpdate: NoAction)
  lingue       lingue    @relation(fields: [id_lingua], references: [id_lingua], onDelete: NoAction, onUpdate: NoAction)
}

model stagioni {
  id_stagione     Int         @id @default(autoincrement())
  titolo_stagione String?
  numero_stagione Int
  id_serie_tv     Int
  contenuti       contenuti[]
  serie_tv        serie_tv    @relation(fields: [id_serie_tv], references: [id_serie_tv], onDelete: NoAction, onUpdate: NoAction)
}

model utenti {
  id_utente      Int              @id @default(autoincrement())
  nome           String
  cognome        String
  email          String           @unique(map: "sqlite_autoindex_utenti_1")
  data_nascita   DateTime
  PASSWORD       String
  createdAt      DateTime         @default(now())
  otpCode        Int?
  otpExpiry      DateTime?
  profili        profili[]
  sottoscrizioni sottoscrizioni[]
}

model valutazioni {
  id_valutazione Int        @id @default(autoincrement())
  punteggio      String
  id_profilo     Int
  id_serie_tv    Int?
  id_film        Int?
  contenuti      contenuti? @relation(fields: [id_film], references: [id_contenuto], onDelete: NoAction, onUpdate: NoAction)
  serie_tv       serie_tv?  @relation(fields: [id_serie_tv], references: [id_serie_tv], onDelete: NoAction, onUpdate: NoAction)
  profili        profili    @relation(fields: [id_profilo], references: [id_profilo], onDelete: NoAction, onUpdate: NoAction)
}